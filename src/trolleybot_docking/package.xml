<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trolleybot_docking</name>
  <version>0.0.0</version>
  <description>Fiducial detection + opennav_docking configuration and lift/latch for trolley docking.</description>
  <maintainer email="bryanlnp@gmail.com">TrolleyBot maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>trolleybot_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
