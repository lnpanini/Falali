<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Drive-under lift platform that raises to engage/carry a trolley.
       Prismatic joint along z. Controlled later by the docking lift action
       (Phase 5) via a position/effort controller; left passive for Phase 1. -->
  <xacro:macro name="trolleybot_lift">

    <joint name="lift_joint" type="prismatic">
      <parent link="chassis_link"/>
      <child link="lift_link"/>
      <origin xyz="0 0 ${chassis_height}"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="0.10" effort="500.0" velocity="0.05"/>
      <dynamics damping="10.0" friction="5.0"/>
    </joint>

    <link name="lift_link">
      <visual>
        <origin xyz="0 0 0.015"/>
        <geometry><box size="${chassis_length*0.9} ${chassis_width*0.9} 0.03"/></geometry>
        <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.015"/>
        <geometry><box size="${chassis_length*0.9} ${chassis_width*0.9} 0.03"/></geometry>
      </collision>
      <xacro:inertial_box mass="3.0" x="${chassis_length*0.9}" y="${chassis_width*0.9}" z="0.03">
        <origin xyz="0 0 0.015"/>
      </xacro:inertial_box>
    </link>

  </xacro:macro>

</robot>
