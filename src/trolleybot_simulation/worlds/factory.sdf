<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="factory">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple factory room: four perimeter walls (10 m x 8 m). -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.5 0 0 0</pose>
        <collision name="north">
          <pose>0 4 0 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="north_v">
          <pose>0 4 0 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </visual>
        <collision name="south">
          <pose>0 -4 0 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </collision>
        <visual name="south_v">
          <pose>0 -4 0 0 0 0</pose>
          <geometry><box><size>10 0.1 1</size></box></geometry>
        </visual>
        <collision name="east">
          <pose>5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </collision>
        <visual name="east_v">
          <pose>5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </visual>
        <collision name="west">
          <pose>-5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </collision>
        <visual name="west_v">
          <pose>-5 0 0 0 0 0</pose>
          <geometry><box><size>0.1 8 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- A trolley to dock under (Phase 5). Replace the box with a model that
         carries an AprilTag once docking work starts. -->
    <include>
      <uri>model://trolley</uri>
      <name>trolley_1</name>
      <pose>2.5 1.5 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
