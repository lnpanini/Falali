<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trolleybot_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch for the real TrolleyBot (hardware interface + controllers + odometry).</description>
  <maintainer email="bryanlnp@gmail.com">TrolleyBot maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>trolleybot_description</exec_depend>
  <exec_depend>trolleybot_hardware</exec_depend>
  <exec_depend>trolleybot_navigation</exec_depend>
  <exec_depend>trolleybot_teleop</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
